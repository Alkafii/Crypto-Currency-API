    {
      "name": "3. Filter price",
      "item": [
        {
          "name": "min_price=1 & max_price=100",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"status = success\", () => pm.expect(j.status).to.eql(\"success\"));",
                  "pm.test(\"1 <= price <= 100\", () => pm.expect(j.data.every(c => c.price_usd >= 1 && c.price_usd <= 100)).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/crypto?min_price=1&max_price=100"
          }
        },
