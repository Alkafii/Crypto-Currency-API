{
  "info": {
    "name": "Crypto API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Basic",
      "item": [
        {
          "name": "Get all crypto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"status = success\", () => pm.expect(j.status).to.eql(\"success\"));",
                  "pm.test(\"total = 200\", () => pm.expect(j.total).to.eql(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/crypto"
          }
        },
        {
          "name": "Get categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"status = success\", () => pm.expect(j.status).to.eql(\"success\"));",
                  "pm.test(\"12 categories\", () => pm.expect(j.data.length).to.eql(12));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "Get detail BTC",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"status = success\", () => pm.expect(j.status).to.eql(\"success\"));",
                  "pm.test(\"symbol = BTC\", () => pm.expect(j.data.symbol).to.eql(\"BTC\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/crypto/BTC"
          }
        },
        {
          "name": "Get detail (lowercase) eth",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"status = success\", () => pm.expect(j.status).to.eql(\"success\"));",
                  "pm.test(\"symbol = ETH\", () => pm.expect(j.data.symbol).to.eql(\"ETH\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/crypto/eth"
          }
        }
      ]
    },
    {
      "name": "2. Filter category",
      "item": [
        {
          "name": "category=DeFi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"status = success\", () => pm.expect(j.status).to.eql(\"success\"));",
                  "pm.test(\"all DeFi\", () => pm.expect(j.data.every(c => c.category === \"DeFi\")).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
