    {
      "name": "5. Error cases",
      "item": [
        {
          "name": "Symbol tidak ada -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"message\", () => pm.expect(pm.response.json().message).to.eql(\"Cryptocurrency not found\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/crypto/NOPE"
          }
        },
        {
          "name": "Category tidak valid -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
